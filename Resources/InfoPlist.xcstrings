{
  "sourceLanguage" : "fr",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "System permission alert shown by iOS before the first camera access. Must say what the camera is used for and what is not done with the images.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iris uses the front camera with ARKit face tracking to estimate where you are looking: your gaze is what pushes the game's spheres away. Images stay on the device and are never recorded or sent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iris utilise la caméra frontale et le suivi facial ARKit pour estimer où vous regardez : c'est votre regard qui repousse les sphères du jeu. Les images restent sur l'appareil, ne sont jamais enregistrées ni envoyées."
          }
        }
      }
    }
  },
  "version" : "1.0"
}