        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le regard est calculé sur l'iPhone, en temps réel. Aucune image, aucune vidéo et aucune donnée du visage n'est enregistrée ni envoyée. Seuls les coefficients de calibration et votre progression sont gardés sur l'appareil."
          }
        }
