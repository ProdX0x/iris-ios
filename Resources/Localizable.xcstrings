    "camera.localProcessing.detail" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Explanatory line under a title. PRIVACY: this is a factual claim about the app. Nothing is recorded, nothing is sent, nothing leaves the device. Translate it exactly; never weaken it and never strengthen it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No image is recorded or sent. Nothing leaves the device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune image n'est enregistrée ni envoyée. Rien ne quitte l'appareil."
          }
        }
      }
    },
    "camera.localProcessing.title" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device processing"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traitement local"
          }
        }
      }
    },
    "camera.noCalibration.detail" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Explanatory line under a title. Says the game starts as soon as a face is detected.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game starts as soon as your face is detected."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu démarre dès que votre visage est détecté."
          }
        }
      }
    },
    "camera.noCalibration.title" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Title.",
