    },
    "gazeLearning.accuracy.note" : {
      "comment" : "The screens that introduce the gaze marker, before the first level. Side note, smaller than the body text. FUNCTIONAL: explains that a lower calibration deviation is better and that 0 % is an ideal reference, not a requirement. The percent signs here are literal text, not placeholders.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lower the calibration deviation, the more closely the calibration matches your gaze. 0% is an ideal reference: no deviation at all is not expected in real use."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus le pourcentage d'écart de calibration est faible, plus la calibration correspond précisément à votre regard. 0 % est une référence idéale : un écart nul n'est pas attendu en usage réel."
          }
        }
      }
    },
    "gazeLearning.choice.detail" : {
      "comment" : "The screens that introduce the gaze marker, before the first level. Explanatory line under a title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can turn assistance back on at any time in Settings, under “Gaze Assistance”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez réactiver une aide à tout moment dans Réglages, « Aide au regard »."
          }
        }
      }
    },
    "gazeLearning.choice.figure" : {
      "comment" : "The screens that introduce the gaze marker, before the first level.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
