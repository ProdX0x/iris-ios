    "gazeLearning.drift.detail" : {
      "comment" : "The screens that introduce the gaze marker, before the first level. Explanatory line under a title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bright dot shows where Iris thinks you are looking. It can move slightly even when you believe you are looking at exactly the same place."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le point lumineux montre où Iris estime que vous regardez. Il peut bouger légèrement même quand vous pensez fixer exactement le même endroit."
          }
        }
      }
    },
    "gazeLearning.drift.figure" : {
      "comment" : "The screens that introduce the gaze marker, before the first level.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three positions close together around the marker, showing that it moves slightly."
          }
