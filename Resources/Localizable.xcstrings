    "onboarding.destination.detail" : {
      "comment" : "First-run introduction. Explanatory line under a title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every sphere has an iris waiting for it. Bring it there, and the level is reached."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque sphère a un iris qui l'attend. Amenez-la jusqu'à lui, et le niveau est atteint."
          }
        }
      }
    },
    "onboarding.destination.figure" : {
      "comment" : "First-run introduction.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sphere reaching the open iris at the end of its path."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sphère qui rejoint l'iris ouvert au bout de son chemin."
          }
        }
      }
    },
    "onboarding.destination.title" : {
      "comment" : "First-run introduction. Title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guide the spheres to their iris"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guidez les sphères vers leur iris"
          }
        }
      }
    },
    "onboarding.directStare.detail" : {
      "comment" : "First-run introduction. Explanatory line under a title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking straight at it drives it away — often far from where you meant to take it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La regarder droit dessus la chasse — souvent loin de l'endroit où vous vouliez l'emmener."
          }
        }
      }
    },
    "onboarding.directStare.figure" : {
      "comment" : "First-run introduction.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gaze resting on the sphere, which moves off away from the iris."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un regard posé sur la sphère, qui part à l'opposé de l'iris."
          }
        }
      }
    },
    "onboarding.directStare.title" : {
      "comment" : "First-run introduction. Title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not stare at the sphere"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne fixez pas la sphère"
          }
        }
      }
    },
    "onboarding.indirectGaze.detail" : {
      "comment" : "First-run introduction. Explanatory line under a title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest your attention beside the sphere: it slides gently to the opposite side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez votre attention à côté de la sphère : elle glisse doucement du côté opposé."
          }
        }
      }
    },
    "onboarding.indirectGaze.figure" : {
      "comment" : "First-run introduction.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gaze resting to the left of the sphere, which slides to the right."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un regard posé à gauche de la sphère, qui glisse vers la droite."
          }
        }
      }
    },
    "onboarding.indirectGaze.title" : {
      "comment" : "First-run introduction. Title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look around it to guide it"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez autour d'elle pour la guider"
          }
        }
      }
    },
    "onboarding.repulsion.detail" : {
      "comment" : "First-run introduction. Explanatory line under a title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iris follows the direction of your gaze. Wherever you look, the sphere moves away."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iris suit la direction de votre regard. Là où vous regardez, la sphère s'écarte."
          }
