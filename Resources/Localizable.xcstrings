        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caméra TrueDepth"
          }
        }
      }
    },
    "camera.unsupported.message" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Message shown when something went wrong. FUNCTIONAL: the device has no TrueDepth face tracking at all. Nothing the player does can change it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device does not have the TrueDepth face tracking needed to detect your gaze."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne dispose pas du suivi facial TrueDepth nécessaire pour détecter le regard."
          }
        }
      }
    },
