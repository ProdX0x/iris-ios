    "access.full.summary" : {
      "comment" : "Access state, shown in the settings and on the paywall. One line summarising a state. FUNCTIONAL: the full access is permanent and tied to the Apple Account, not the device.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iris is fully unlocked on this Apple Account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iris est ouvert en entier sur ce compte Apple."
          }
        }
      }
    },
    "access.promotional.detail" : {
      "comment" : "Access state, shown in the settings and on the paywall. Explanatory line under a title. FUNCTIONAL: says the access lasts as long as its duration, no longer.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iris stays fully unlocked for the duration of your access."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iris est ouvert en entier pendant la durée de votre accès."
          }
        }
      }
    },
    "access.promotional.summary" : {
      "comment" : "Access state, shown in the settings and on the paywall. One line summarising a state. FUNCTIONAL: a temporary access opens everything, and when it ends the free chapters stay open. Both halves matter.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporary access unlocks all of Iris. When it ends, the free chapters stay open."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un accès temporaire ouvre Iris en entier. À sa fin, les chapitres gratuits restent ouverts."
          }
        }
      }
    },
    "camera.allow.action" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Button label — keep it short enough for a control.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Camera"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser la caméra"
          }
        }
      }
    },
    "camera.denied.detail" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Explanatory line under a title. The camera was refused; says the game cannot work without the gaze, and that it can be allowed again in Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access was denied. Without your gaze, Iris cannot work. You can allow it in Settings, then come back here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la caméra a été refusé. Sans regard, Iris ne peut pas fonctionner. Vous pouvez l'autoriser dans Réglages, puis revenir ici."
          }
        }
      }
    },
    "camera.denied.message" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Message shown when something went wrong. Shorter form of the same, shown over a level.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iris needs the front camera to read your gaze. Allow it in Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iris a besoin de la caméra frontale pour lire votre regard. Autorisez-la dans Réglages."
          }
        }
      }
    },
    "camera.denied.title" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
