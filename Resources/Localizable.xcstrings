      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achat unique. Aucun abonnement, aucun renouvellement."
          }
        }
      }
    },
    "settings.audio.soundEffects" : {
      "comment" : "Settings. Toggle label for the short sounds the game plays on events. Keep it to two words if the language allows.",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
