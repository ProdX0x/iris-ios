    "paywall.notASubscription" : {
      "comment" : "Paywall: what the full access is and how to get it. COMMERCIAL: Iris sells one non-consumable purchase. Never translate this as a subscription, a plan, or anything renewing.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-time purchase. No subscription, no renewal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achat unique. Aucun abonnement, aucun renouvellement."
          }
        }
      }
    },
    "paywall.priceUnavailable" : {
      "comment" : "Paywall: what the full access is and how to get it. Shown when the App Store did not return a price. Must keep both halves: the price could not be read, and the free chapters stay open.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The price could not be retrieved from the App Store. Try again later: the free chapters stay open."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prix n'a pas pu être lu sur l'App Store. Réessayez plus tard : les chapitres gratuits restent ouverts."
          }
        }
      }
    },
    "paywall.progressIsKept" : {
      "comment" : "Paywall: what the full access is and how to get it. Reassurance: progress is stored on the device and survives the purchase.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
