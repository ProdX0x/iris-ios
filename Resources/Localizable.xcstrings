      }
    },
    "camera.request.detail" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Explanatory line under a title. PRIVACY: explains what iOS is about to ask and what the camera is used for.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS will ask for permission to use the front camera. It is used only to detect where you are looking."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS va vous demander l'autorisation d'utiliser la caméra frontale. Elle sert uniquement à détecter où vous regardez."
          }
        }
      }
    },
    "camera.requesting" : {
      "comment" : "Camera permission screen, shown before the gaze can be read.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requesting access…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande d'accès en cours…"
          }
        }
      }
    },
    "camera.restricted.detail" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Explanatory line under a title. FUNCTIONAL: the restriction comes from Screen Time or a management profile, not from a refusal by the player. Keep that distinction.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is restricted on this device (Screen Time, management profile). Iris cannot read your gaze while that restriction is active."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la caméra est restreint sur cet appareil (temps d'écran, profil de gestion). Iris ne peut pas lire le regard tant que cette restriction est active."
          }
        }
      }
    },
    "camera.restricted.message" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Message shown when something went wrong. Shorter form of the same.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is restricted on this device (Screen Time or a profile)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la caméra est restreint sur cet appareil (temps d'écran ou profil)."
          }
        }
      }
    },
