    "howToPlay.intro" : {
      "comment" : "How-to-play explanations.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iris is played with your eyes. The front camera estimates the direction of your gaze; the rest comes down to four ideas."
          }
