    "camera.trueDepth.detail" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Explanatory line under a title. Describes what the TrueDepth camera does, about sixty times a second.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimates the direction of your gaze, about sixty times a second."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estime la direction du regard, environ soixante fois par seconde."
          }
        }
      }
    },
    "camera.trueDepth.title" : {
      "comment" : "Camera permission screen, shown before the gaze can be read. Title.",
