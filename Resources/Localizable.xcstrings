    "gazeLearning.guided.detail" : {
      "comment" : "The screens that introduce the gaze marker, before the first level. Explanatory line under a title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the first two levels, the marker stays visible. In the third, it fades away to teach you to play without it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les deux premiers niveaux, le repère reste visible. Au troisième, il disparaît progressivement pour vous apprendre à jouer sans lui."
