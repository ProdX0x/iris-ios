    "chapters.card.label" : {
      "comment" : "Chapter map. VoiceOver label: what is read aloud, not what is drawn. VoiceOver label of a chapter card. %lld is the chapter number, %@ its name, then the number of levels reached and the number of levels it holds. Keep all four, in an order the sentence allows.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chapter %lld, %@, %lld of %lld levels reached"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chapitre %lld, %@, %lld niveaux sur %lld atteints"
          }
        }
      }
    },
    "chapters.card.label.locked" : {
      "comment" : "Chapter map. Same as `chapters.card.label`, for a chapter the player has not bought. %lld chapter number, %@ name, levels reached, levels in total. The ending says the full access is required.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chapter %lld, %@, %lld of %lld levels reached, full access required"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chapitre %lld, %@, %lld niveaux sur %lld atteints, accès complet requis"
          }
        }
      }
    },
    "chapters.level.label" : {
      "comment" : "Chapter map. VoiceOver label: what is read aloud, not what is drawn. VoiceOver label of a level. %lld is the level number inside its chapter, %@ its title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Level %lld, %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niveau %lld, %@"
          }
        }
      }
    },
    "chapters.level.locked" : {
      "comment" : "Chapter map.",
      "extractionState" : "manual",
      "localizations" : {
