<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Iris does no tracking: it links nothing to data from other apps or websites, and has no advertising SDK. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Iris collects nothing: it contains no networking code at all (no URLSession, no Network framework, no
	     backend, no analytics). The camera feed, the gaze estimate, the calibration coefficients and the campaign
	     progress never leave the device. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- UserDefaultsProgressStore, UserDefaultsCalibrationStore, GameSettingsStore, OnboardingStore:
			     the app's own preferences and progress, readable by nothing else. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!-- ProcessInfo.systemUptime timestamps gaze samples (SimulatedGazeTrackingService) and the DEBUG
			     diagnostics: elapsed time between events inside the app. Nothing is sent off-device. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
