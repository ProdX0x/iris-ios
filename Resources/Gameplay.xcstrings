    "level.2-6.hint.afterSeconds.40" : {
      "comment" : "Instruction shown during level II-6 when 40 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What shines around it does not count. Only the heart."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui brille autour ne compte pas. Seul le cœur."
          }
        }
