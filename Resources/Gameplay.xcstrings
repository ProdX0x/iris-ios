      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An iris shut in, with a single way in."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un iris enfermé, une seule entrée."
          }
        }
      }
    },
    "level.4-6.title" : {
