          "stringUnit" : {
            "state" : "translated",
            "value" : "Not here. They come back and shine for a moment: look again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas ici. Elles reviennent briller un instant : regardez encore."
          }
        }
