    },
    "level.7-7.hint.oculoCompleted" : {
      "comment" : "Instruction shown during level VII-7 when the oculomotor sequence is complete. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Their bond is complete. They slide towards each other: let them come together."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leur lien est complet. Elles glissent l'une vers l'autre : laissez-les se rejoindre."
          }
        }
      }
    },
    "level.7-7.hint.start" : {
      "comment" : "Instruction shown during level VII-7 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two twins, two opposite corners. Look at the one that breathes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux jumelles, deux coins opposés. Regardez celle qui respire."
