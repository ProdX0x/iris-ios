            "state" : "translated",
            "value" : "current"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "courant"
          }
        }
      }
    },
    "element.courant.summary" : {
      "comment" : "What the element `courant` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It carries the glimmers away. Push them with your gaze."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il emporte les lueurs. Poussez-les avec votre regard."
          }
        }
      }
    },
    "element.croisement.name" : {
      "comment" : "Name of the game element `croisement`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "crossing"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "croisement"
          }
        }
      }
    },
    "element.croisement.summary" : {
      "comment" : "What the element `croisement` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The twins call to each other from corner to corner. Answer the one that breathes: their bond tightens."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jumelles s'appellent d'un coin à l'autre. Répondez à celle qui respire : leur lien se resserre."
          }
        }
      }
    },
    "element.dormeuse.name" : {
      "comment" : "Name of the game element `dormeuse`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sleeper"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dormeuse"
          }
        }
      }
    },
    "element.dormeuse.summary" : {
      "comment" : "What the element `dormeuse` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps: it does not move and its iris stays shut. Only an echo wakes it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle dort : elle ne bouge pas et son iris reste fermé. Seul un écho la réveille."
          }
        }
      }
    },
    "element.echo.name" : {
      "comment" : "Name of the game element `echo`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "echo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "écho"
          }
        }
      }
    },
    "element.echo.summary" : {
      "comment" : "What the element `echo` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An iris closing breathes out an echo. It wakes the sleepers within reach and sets them off."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un iris qui se ferme respire un écho. Il réveille les dormeuses à portée et les lance."
          }
        }
      }
    },
    "element.ecran.name" : {
      "comment" : "Name of the game element `ecran`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "eyes on the screen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "regard sur l'écran"
          }
        }
      }
    },
    "element.ecran.summary" : {
      "comment" : "What the element `ecran` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your eyes leave the screen, the irises close."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vos yeux quittent l'écran, les iris se ferment."
          }
        }
      }
    },
    "element.etoileAbsente.name" : {
      "comment" : "Name of the game element `etoileAbsente`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "absent star"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "étoile absente"
          }
        }
      }
    },
    "element.etoileAbsente.summary" : {
      "comment" : "What the element `etoileAbsente` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It shines for a moment, then fades. Go back to where it was: it returns, and the constellation grows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle brille un instant puis s'efface. Retournez là où elle était : elle revient, et la constellation grandit."
          }
        }
      }
    },
    "element.filVivant.name" : {
      "comment" : "Name of the game element `filVivant`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "living thread"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fil vivant"
          }
        }
      }
    },
    "element.filVivant.summary" : {
      "comment" : "What the element `filVivant` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It runs and never stops. Follow it with your gaze: the thread it leaves behind stays alive."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle file sans jamais s'arrêter. Accompagnez-la du regard : le fil qu'elle laisse reste vivant."
          }
        }
      }
    },
    "element.gouffre.name" : {
      "comment" : "Name of the game element `gouffre`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "chasm"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gouffre"
          }
        }
      }
    },
    "element.gouffre.summary" : {
      "comment" : "What the element `gouffre` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It draws in whatever comes close. What it swallows goes back to where it started."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il aspire ce qui s'approche. Ce qu'il avale revient à son départ."
          }
        }
      }
    },
    "element.iris.name" : {
      "comment" : "Name of the game element `iris`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iris"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iris"
          }
        }
      }
    },
    "element.iris.summary" : {
      "comment" : "What the element `iris` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A glimmer must stay in it for three quarters of a second for it to close."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une lueur doit y rester trois quarts de seconde pour qu'il se ferme."
          }
        }
      }
    },
    "element.irisMouvant.name" : {
      "comment" : "Name of the game element `irisMouvant`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "drifting iris"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iris mouvant"
          }
        }
      }
    },
    "element.irisMouvant.summary" : {
      "comment" : "What the element `irisMouvant` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iris slides. Anticipate it without staring at it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'iris glisse. Anticipez sans le fixer."
          }
        }
      }
    },
    "element.jardin.name" : {
      "comment" : "Name of the game element `jardin`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hidden garden"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jardin caché"
          }
        }
      }
    },
    "element.jardin.summary" : {
      "comment" : "What the element `jardin` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Among the seeds that glitter, a few are breathing. Rest your gaze on those: they grow."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmi les graines qui scintillent, quelques-unes respirent. Posez le regard sur celles-là : elles poussent."
          }
        }
      }
    },
    "element.jumelles.name" : {
      "comment" : "Name of the game element `jumelles`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "twins"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jumelles"
          }
        }
      }
    },
    "element.jumelles.summary" : {
      "comment" : "What the element `jumelles` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They have no iris: each one is the other's iris. Bring them together."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles n'ont pas d'iris : chacune est l'iris de l'autre. Réunissez-les."
          }
        }
      }
    },
    "element.lanterne.name" : {
      "comment" : "Name of the game element `lanterne`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "lantern of the current"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "lanterne du courant"
          }
        }
      }
    },
    "element.lanterne.summary" : {
      "comment" : "What the element `lanterne` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current always carries it along the same path. In the mist it disappears: be where it comes out."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le courant la porte toujours par le même chemin. Dans la brume elle disparaît : soyez là où elle ressort."
          }
        }
      }
    },
    "element.lueur.name" : {
      "comment" : "Name of the game element `lueur`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "glimmer"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "lueur"
          }
        }
      }
    },
    "element.lueur.summary" : {
      "comment" : "What the element `lueur` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It flees your gaze and reaches its iris when left alone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle fuit votre regard et rejoint son iris quand on la laisse."
          }
        }
      }
    },
    "element.miroir.name" : {
      "comment" : "Name of the game element `miroir`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "lying mirror"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "miroir menteur"
          }
        }
      }
    },
    "element.miroir.summary" : {
      "comment" : "What the element `miroir` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What shines on one side calls the gaze; the door opens on the other. Do not follow the glare."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui brille d'un côté appelle le regard ; la porte s'ouvre de l'autre. Ne suivez pas l'éclat."
          }
        }
      }
    },
    "element.orchestre.name" : {
      "comment" : "Name of the game element `orchestre`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "orchestra of the gaze"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "orchestre du regard"
          }
        }
      }
    },
    "element.orchestre.summary" : {
      "comment" : "What the element `orchestre` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything your eyes have learned, in a single breath. Each passage lights a star."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que vos yeux ont appris, d'un seul souffle. Chaque passage allume une étoile."
          }
        }
      }
    },
    "element.ordre.name" : {
      "comment" : "Name of the game element `ordre`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "order"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ordre"
          }
        }
      }
    },
    "element.ordre.summary" : {
      "comment" : "What the element `ordre` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The numbers set the order: 1, then 2, then 3."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les numéros fixent l'ordre : 1, puis 2, puis 3."
          }
        }
      }
    },
    "element.premierRegard.name" : {
      "comment" : "Name of the game element `premierRegard`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "eyes first"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "d'abord les yeux"
          }
        }
      }
    },
    "element.premierRegard.summary" : {
      "comment" : "What the element `premierRegard` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An ember lights up at the edge. Go there with your eyes, then let your head follow: it gives all its warmth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une braise s'allume au bord. Allez-y des yeux, puis laissez la tête suivre : elle donne toute sa chaleur."
          }
        }
      }
    },
    "element.souffle.name" : {
      "comment" : "Name of the game element `souffle`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "breath"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "souffle"
          }
        }
      }
    },
    "element.souffle.summary" : {
      "comment" : "What the element `souffle` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It passes back and forth along its path. What it passes through, it carries over the veils."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il passe et repasse sur son chemin. Ce qu'il traverse, il l'emporte par-dessus les voiles."
          }
        }
      }
    },
    "element.temperaments.name" : {
      "comment" : "Name of the game element `temperaments`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "temperaments"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tempéraments"
          }
        }
      }
    },
    "element.temperaments.summary" : {
      "comment" : "What the element `temperaments` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The quick glimmer flees at the slightest look, the heavy one resists."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lueur vive fuit au moindre regard, la lourde résiste."
          }
        }
      }
    },
    "element.veilleuse.name" : {
      "comment" : "Name of the game element `veilleuse`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "watchlight"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "veilleuse"
          }
        }
      }
    },
    "element.veilleuse.summary" : {
      "comment" : "What the element `veilleuse` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at the flame to revive it. Once out, it closes its irises."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez la flamme pour la raviver. Éteinte, elle ferme ses iris."
          }
        }
      }
    },
    "element.voile.name" : {
      "comment" : "Name of the game element `voile`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
