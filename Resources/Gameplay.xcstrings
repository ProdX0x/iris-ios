    "level.7-7.hint.afterSeconds.40" : {
      "comment" : "Instruction shown during level VII-7 when 40 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only one breathes at a time. Go to it, then to the other corner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule respire à la fois. Allez à elle, puis à l'autre coin."
