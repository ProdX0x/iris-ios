    "level.8-7.hint.afterSeconds.45" : {
      "comment" : "Instruction shown during level VIII-7 when 45 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the mist, keep following it with your gaze, at the same pace as before."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la brume, continuez de la suivre du regard, au même pas qu'avant."
          }
        }
      }
    },
    "level.8-7.hint.firstOculoMiss" : {
      "comment" : "Instruction shown during level VIII-7 when the first oculomotor target is missed. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It came out without you. Next time round, keep its rhythm through the mist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est ressortie sans vous. Au prochain passage, gardez son rythme dans la brume."
          }
        }
      }
    },
    "level.8-7.hint.firstOculoSuccess" : {
      "comment" : "Instruction shown during level VIII-7 when the first oculomotor target is reached. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You were there. Every mist has its way out."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous étiez là. Chaque brume a sa sortie."
          }
        }
      }
    },
    "level.8-7.hint.oculoCompleted" : {
      "comment" : "Instruction shown during level VIII-7 when the oculomotor sequence is complete. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current knows you now. The iris opens: let the glimmer come."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le courant vous connaît. L'iris s'ouvre : laissez la lueur venir."
          }
        }
      }
    },
    "level.8-7.hint.start" : {
      "comment" : "Instruction shown during level VIII-7 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow the lantern. The current always brings it back along the same path."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez la lanterne. Le courant la ramène toujours par le même chemin."
          }
        }
      }
    },
    "level.8-7.principle" : {
      "comment" : "What level VIII-7 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current carries a lantern, always along the same path. In the mist it disappears: be where it comes out."
