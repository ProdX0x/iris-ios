    },
    "level.7-3.hint.start" : {
      "comment" : "Instruction shown during level VII-3 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lone one reaches its iris on its own. Go around it with the twin."
