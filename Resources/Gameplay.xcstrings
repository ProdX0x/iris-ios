        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jumelles et gouffre"
          }
        }
      }
    },
    "level.12-4.hint.firstWake" : {
      "comment" : "Instruction shown during level XII-4 when something wakes for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The echo has passed the veil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écho a passé le voile."
          }
        }
      }
    },
    "level.12-4.hint.start" : {
      "comment" : "Instruction shown during level XII-4 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The breath carries the awakened one. Its iris, once closed, will wake the sleeper."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le souffle porte l'éveillée. Son iris, une fois fermé, réveillera la dormeuse."
          }
        }
      }
    },
    "level.12-4.principle" : {
      "comment" : "What level XII-4 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sleeper waits on the far side of the veil, within reach of an iris only the breath can close."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dormeuse attend de l'autre côté du voile, à portée d'un iris que seul le souffle permet de fermer."
          }
        }
      }
    },
    "level.12-4.title" : {
      "comment" : "Title of level XII-4. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
