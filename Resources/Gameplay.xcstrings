    "level.7-3.hint.firstLoss" : {
      "comment" : "Instruction shown during level VII-3 when the player loses something for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your gaze drove the lone one away. It will come back."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre regard a chassé la solitaire. Elle reviendra."
          }
