      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The constellation is drawn. The iris opens; the flame lights it, do not forget it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La constellation est dessinée. L'iris s'ouvre ; la flamme l'éclaire, ne l'oubliez pas."
          }
        }
      }
    },
    "level.5-7.hint.start" : {
      "comment" : "Instruction shown during level V-7 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
