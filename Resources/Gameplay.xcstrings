    },
    "level.12-5.hint.start" : {
      "comment" : "Instruction shown during level XII-5 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
