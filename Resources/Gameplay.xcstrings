    "level.3-7.hint.start" : {
      "comment" : "Instruction shown during level III-7 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The spark never stops. Keep it under your gaze, without running ahead of it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'étincelle ne s'arrête jamais. Gardez-la sous le regard, sans la devancer."
          }
        }
      }
    },
    "level.3-7.principle" : {
