    },
    "level.2-6.hint.firstOculoMiss" : {
      "comment" : "Instruction shown during level II-6 when the first oculomotor target is missed. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A spark caught your gaze: the heart cooled a little."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une étincelle vous a pris le regard : le cœur a refroidi un peu."
          }
        }
      }
    },
    "level.2-6.hint.oculoCompleted" : {
      "comment" : "Instruction shown during level II-6 when the oculomotor sequence is complete. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The heart opens. Two glimmers wake: let them come."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cœur s'ouvre. Deux lueurs s'éveillent : laissez-les venir."
          }
        }
      }
    },
    "level.2-6.hint.start" : {
      "comment" : "Instruction shown during level II-6 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A glass heart, cold. Rest your gaze on it and let it warm up."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cœur de verre, froid. Posez-y le regard et laissez-le se réchauffer."
          }
        }
      }
    },
    "level.2-6.principle" : {
      "comment" : "What level II-6 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cold heart. Your gaze, if it stays, warms it; what shines around it cools it down."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cœur froid. Votre regard, s'il reste, le réchauffe ; ce qui brille autour le refroidit."
          }
        }
      }
    },
