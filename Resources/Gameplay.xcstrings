    },
    "element.voile.summary" : {
      "comment" : "What the element `voile` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The glimmers do not pass through it. Push them around it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lueurs ne le traversent pas. Poussez-les autour."
          }
        }
      }
    },
    "hint.generic.balises" : {
      "comment" : "Late help shown in any level that names none of its own, chosen by the shape of the level (`balises`). Generic on purpose: it must fit every level of that shape.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the beacon that breathes wakes, under a resting gaze."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule la balise qui respire s'éveille, sous un regard posé."
          }
        }
      }
    },
    "hint.generic.emptySpace" : {
      "comment" : "Late help shown in any level that names none of its own, chosen by the shape of the level (`emptySpace`). Generic on purpose: it must fit every level of that shape.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for the emptiest space on the screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cherchez l'espace le plus vide de l'écran."
          }
        }
