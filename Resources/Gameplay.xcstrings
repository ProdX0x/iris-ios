    "level.1-6.hint.afterSeconds.40" : {
      "comment" : "Instruction shown during level I-6 when 40 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the beacon that breathes can wake. Keep your gaze on it for a moment."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule la balise qui respire peut s'éveiller. Restez posé dessus un instant."
