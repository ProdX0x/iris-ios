        }
      }
    },
    "level.4-7.hint.afterSeconds.45" : {
      "comment" : "Instruction shown during level IV-7 when 45 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not look at what shines. Look where it does not."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne regardez pas ce qui brille. Regardez là où il ne brille pas."
          }
        }
      }
    },
    "level.4-7.hint.firstOculoMiss" : {
      "comment" : "Instruction shown during level IV-7 when the first oculomotor target is missed. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The glare was lying. The door will open again: go to the opposite side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'éclat mentait. La porte se rouvrira : allez en face."
          }
        }
      }
    },
    "level.4-7.hint.firstOculoSuccess" : {
      "comment" : "Instruction shown during level IV-7 when the first oculomotor target is reached. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The door gave way. Each glare announces another, always on the opposite side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La porte a cédé. Chaque éclat en annonce une autre, toujours en face."
          }
        }
      }
    },
    "level.4-7.hint.oculoCompleted" : {
      "comment" : "Instruction shown during level IV-7 when the oculomotor sequence is complete. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every door has given way. The iris opens: go around the veil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les portes ont cédé. L'iris s'ouvre : contournez le voile."
          }
        }
      }
    },
    "level.4-7.hint.start" : {
      "comment" : "Instruction shown during level IV-7 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A glare is about to shine. The door, though, opens on the opposite side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un éclat va briller. La porte, elle, s'ouvre en face."
          }
        }
      }
    },
    "level.4-7.principle" : {
      "comment" : "What level IV-7 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A glare calls the gaze to one side; the door opens on the other. The veil gives way only at its doors."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un éclat appelle le regard d'un côté ; la porte s'ouvre de l'autre. Le voile ne cède qu'aux portes."
          }
        }
      }
    },
