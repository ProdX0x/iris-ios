    "level.9-1.hint.firstValidation" : {
      "comment" : "Instruction shown during level IX-1 when the first target is validated. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iris closes and breathes out. Watch the echo."
          }
        },
        "fr" : {
