    "level.8-1.hint.afterSeconds.30" : {
      "comment" : "Instruction shown during level VIII-1 when 30 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look far to its right: it slides to the left, onto the path."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez loin à sa droite : elle glisse vers la gauche, jusqu'au chemin."
