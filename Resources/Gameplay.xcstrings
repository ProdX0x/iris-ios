          }
        }
      }
    },
    "level.7-2.hint.start" : {
      "comment" : "Instruction shown during level VII-2 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The veil separates them. Go around it on the right."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voile les sépare. Contournez-le par la droite."
          }
        }
