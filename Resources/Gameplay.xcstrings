    },
    "level.12-6.hint.firstWake" : {
      "comment" : "Instruction shown during level XII-6 when something wakes for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last iris is waiting for it, below."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dernier iris l'attend, en bas."
          }
        }
      }
    },
    "level.12-6.hint.start" : {
      "comment" : "Instruction shown during level XII-6 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The twins first. Once together, they breathe out an echo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jumelles d'abord. Réunies, elles respirent un écho."
          }
        }
      }
    },
    "level.12-6.hint.twinsLinked" : {
      "comment" : "Instruction shown during level XII-6 when the two twins are linked. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They come together. Now take the sleeper around the right side of the chasm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles se rejoignent. Maintenant la dormeuse, par la droite du gouffre."
          }
        }
      }
    },
    "level.12-6.principle" : {
      "comment" : "What level XII-6 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring the twins together; their meeting place is breathing. Bring the sleeper within reach, around the chasm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réunissez les jumelles ; leur rendez-vous respire. Amenez la dormeuse à portée, autour du gouffre."
          }
        }
      }
    },
    "level.12-6.title" : {
      "comment" : "Title of level XII-6. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the last iris"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "le dernier iris"
          }
        }
      }
    },
    "level.12-7.hint.afterSeconds.60" : {
      "comment" : "Instruction shown during level XII-7 when 60 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each passage is a memory: the heart, the answer, the thread, the garden, the stars, the twins, the ember."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque passage est un souvenir : le cœur, la réponse, le fil, le jardin, les étoiles, les jumelles, la braise."
          }
        }
      }
    },
    "level.12-7.hint.firstOculoSuccess" : {
      "comment" : "Instruction shown during level XII-7 when the first oculomotor target is reached. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A star lights up. Each passage lights another."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une étoile s'allume. Chaque passage en allume une autre."
          }
        }
      }
    },
    "level.12-7.hint.oculoCompleted" : {
      "comment" : "Instruction shown during level XII-7 when the oculomotor sequence is complete. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The constellation is whole. The twins come down to join it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La constellation est entière. Les jumelles descendent la rejoindre."
          }
        }
      }
    },
    "level.12-7.hint.start" : {
      "comment" : "Instruction shown during level XII-7 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A glass heart. Rest your gaze on it, as at the beginning."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cœur de verre. Posez le regard, comme au début."
          }
        }
      }
    },
    "level.12-7.principle" : {
      "comment" : "What level XII-7 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything your eyes have learned, in a single breath. Each passage lights a star."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que vos yeux ont appris, d'un seul souffle. Chaque passage allume une étoile."
          }
        }
      }
    },
    "level.12-7.title" : {
      "comment" : "Title of level XII-7. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
