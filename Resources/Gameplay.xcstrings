    "chapter.1.name" : {
      "comment" : "Name of chapter I (1 of 12). Chapter names are short, lowercase and evocative — they name a movement of the eyes, not a place. Not a sentence, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "awakening"
          }
