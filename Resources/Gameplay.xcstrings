    "element.absence.summary" : {
      "comment" : "What the element `absence` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une présence tient tant que vous la regardez. Quand une autre répond, parfois après un silence, allez à elle."
