    },
    "level.9-1.title" : {
      "comment" : "Title of level IX-1. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the echo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "l'écho"
          }
        }
      }
    },
    "level.9-2.hint.firstWake" : {
      "comment" : "Instruction shown during level IX-2 when something wakes for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The echo sets it off. It reaches its iris on its own."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écho la lance. Elle rejoint son iris seule."
          }
        }
      }
    },
    "level.9-2.hint.start" : {
      "comment" : "Instruction shown during level IX-2 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asleep, it still flees your gaze. Push it towards the other one's iris."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endormie, elle fuit encore votre regard. Poussez-la vers l'iris de l'autre."
          }
        }
      }
    },
    "level.9-2.principle" : {
      "comment" : "What level IX-2 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The echo does not carry that far. Bring it closer first."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écho ne porte pas jusqu'à elle. Rapprochez-la avant."
          }
        }
      }
    },
    "level.9-2.title" : {
      "comment" : "Title of level IX-2. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "out of reach"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hors de portée"
          }
        }
      }
    },
    "level.9-3.hint.firstWake" : {
      "comment" : "Instruction shown during level IX-3 when something wakes for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its iris will breathe out in turn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son iris respirera à son tour."
          }
        }
      }
    },
    "level.9-3.hint.start" : {
      "comment" : "Instruction shown during level IX-3 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two sleepers. The first is within reach; the second is within reach of no iris."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux dormeuses. La première est à portée ; la seconde ne l'est d'aucun iris."
          }
        }
      }
    },
    "level.9-3.principle" : {
      "comment" : "What level IX-3 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One echo wakes a sleeper, whose iris wakes another."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un écho en réveille une, dont l'iris en réveille une autre."
          }
        }
      }
    },
    "level.9-3.title" : {
      "comment" : "Title of level IX-3. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the chain"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la chaîne"
          }
        }
      }
    },
    "level.9-4.hint.firstWake" : {
      "comment" : "Instruction shown during level IX-4 when something wakes for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set off by the echo, it leaves the current."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancée par l'écho, elle sort du courant."
          }
        }
      }
    },
    "level.9-4.hint.start" : {
      "comment" : "Instruction shown during level IX-4 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the current, the sleeper drifts to the right. Keep it within reach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le courant, la dormeuse dérive vers la droite. Tenez-la à portée."
          }
        }
      }
    },
    "level.9-4.principle" : {
      "comment" : "What level IX-4 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current carries it away from the iris that must wake it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le courant l'éloigne de l'iris qui doit la réveiller."
          }
        }
      }
    },
    "level.9-4.title" : {
      "comment" : "Title of level IX-4. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "against the echo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "à contre-écho"
          }
        }
      }
    },
    "level.9-5.hint.start" : {
      "comment" : "Instruction shown during level IX-5 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The flame closes the upper iris if it goes out. Tend to it, then wake it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flamme ferme l'iris du haut si elle s'éteint. Servez-la, puis réveillez."
          }
        }
      }
    },
    "level.9-5.hint.veilleuseLow" : {
      "comment" : "Instruction shown during level IX-5 when the veilleuse is running low. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The flame is weakening."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flamme faiblit."
          }
        }
      }
    },
    "level.9-5.principle" : {
      "comment" : "What level IX-5 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The flame lights the iris that must close. Without it, no echo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flamme éclaire l'iris qui doit se fermer. Sans elle, pas d'écho."
          }
        }
      }
    },
    "level.9-5.title" : {
      "comment" : "Title of level IX-5. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the flame and the echo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la flamme et l'écho"
          }
        }
      }
    },
    "level.9-6.hint.firstLoss" : {
      "comment" : "Instruction shown during level IX-6 when the player loses something for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An iris that opens again drags the next ones with it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un iris qui se rouvre entraîne les suivants."
          }
        }
      }
    },
    "level.9-6.hint.start" : {
      "comment" : "Instruction shown during level IX-6 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The awakened one first. Bring each sleeper within reach of its echo, in order."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'éveillée d'abord. Amenez chaque dormeuse à portée de son écho, dans l'ordre."
          }
        }
      }
    },
    "level.9-6.principle" : {
      "comment" : "What level IX-6 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In order: the awakened one, then each sleeper its echo reaches. The veil forces the detour."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l'ordre : l'éveillée, puis chaque dormeuse que son écho atteint. Le voile impose le détour."
          }
        }
      }
    },
    "level.9-6.title" : {
      "comment" : "Title of level IX-6. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "three voices"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "trois voix"
          }
        }
      }
    },
    "level.9-7.hint.afterSeconds.45" : {
      "comment" : "Instruction shown during level IX-7 when 45 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the answer appears, leave the first one, even if it is still shining."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand la réponse paraît, quittez la première, même si elle brille encore."
          }
        }
      }
    },
    "level.9-7.hint.firstOculoMiss" : {
      "comment" : "Instruction shown during level IX-7 when the first oculomotor target is missed. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The answer has faded. Come back to the presence: it will call again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse s'est éteinte. Revenez à la présence : elle rappellera."
          }
        }
      }
    },
    "level.9-7.hint.firstOculoSuccess" : {
      "comment" : "Instruction shown during level IX-7 when the first oculomotor target is reached. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It answered and you went to it. Stay with it: another will come."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle a répondu et vous l'avez rejointe. Restez avec elle : une autre viendra."
          }
        }
      }
    },
    "level.9-7.hint.oculoCompleted" : {
      "comment" : "Instruction shown during level IX-7 when the oculomotor sequence is complete. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The echoes have all answered one another. The glimmers wake: let the echo do the rest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les échos se sont tous répondu. Les lueurs s'éveillent : laissez l'écho faire le reste."
          }
        }
      }
    },
    "level.9-7.hint.start" : {
      "comment" : "Instruction shown during level IX-7 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A presence at the centre. Rest your gaze on it, and stay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une présence au centre. Posez-y le regard, et restez."
          }
        }
      }
    },
    "level.9-7.principle" : {
      "comment" : "What level IX-7 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A presence holds as long as you look at it. When another answers it, sometimes after a silence, go to it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une présence tient tant que vous la regardez. Quand une autre lui répond, parfois après un silence, allez à elle."
          }
        }
      }
    },
    "level.9-7.title" : {
      "comment" : "Title of level IX-7. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "absence"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "l'absence"
          }
        }
      }
    },
    "level.10-1.hint.afterSeconds.30" : {
      "comment" : "Instruction shown during level X-1 when 30 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push it aside before the chasm draws it in."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez-la sur le côté avant qu'il ne l'aspire."
          }
        }
      }
    },
    "level.10-1.hint.firstSwallow" : {
      "comment" : "Instruction shown during level X-1 when something is swallowed for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swallowed, it goes back to the start. Everything has to be done again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avalée, elle revient au départ. Tout est à refaire."
          }
        }
      }
    },
    "level.10-1.hint.start" : {
      "comment" : "Instruction shown during level X-1 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left to itself, it heads straight for the chasm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livrée à elle-même, elle file droit vers le gouffre."
          }
        }
      }
    },
    "level.10-1.principle" : {
      "comment" : "What level X-1 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chasm sits on the direct path. Go around it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gouffre est sur le chemin direct. Contournez-le."
          }
        }
      }
    },
    "level.10-1.title" : {
      "comment" : "Title of level X-1. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the chasm"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "le gouffre"
          }
        }
      }
    },
    "level.10-2.hint.firstSwallow" : {
      "comment" : "Instruction shown during level X-2 when something is swallowed for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too close. It goes back to the start."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop près. Elle revient au départ."
          }
        }
      }
    },
    "level.10-2.hint.start" : {
      "comment" : "Instruction shown during level X-2 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pull begins well before the mouth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aspiration commence bien avant la bouche."
          }
        }
      }
    },
    "level.10-2.principle" : {
      "comment" : "What level X-2 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two chasms, and their pull overlaps. Pass wide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux gouffres, et leur aspiration se touche. Passez large."
          }
        }
      }
    },
    "level.10-2.title" : {
      "comment" : "Title of level X-2. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the pull"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "l'aspiration"
          }
        }
      }
    },
    "level.10-3.hint.firstSwallow" : {
      "comment" : "Instruction shown during level X-3 when something is swallowed for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swallowed. It sets off again in the current."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avalée. Elle repart dans le courant."
          }
        }
      }
    },
    "level.10-3.hint.start" : {
      "comment" : "Instruction shown during level X-3 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current carries it towards the chasm. Push it downwards."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le courant l'emporte vers le gouffre. Poussez-la vers le bas."
          }
        }
      }
    },
    "level.10-3.principle" : {
      "comment" : "What level X-3 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current carries it straight into the chasm. Take it out of the current first."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le courant la porte droit dans le gouffre. Sortez-la du courant avant."
          }
        }
      }
    },
    "level.10-3.title" : {
      "comment" : "Title of level X-3. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the current and the chasm"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "le courant et le gouffre"
          }
        }
      }
    },
    "level.10-4.hint.start" : {
      "comment" : "Instruction shown during level X-4 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The flame is at the top, the chasm at the centre. Go around on the right."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flamme est en haut, le gouffre au centre. Faites le tour par la droite."
          }
        }
      }
    },
    "level.10-4.hint.veilleuseLow" : {
      "comment" : "Instruction shown during level X-4 when the veilleuse is running low. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The flame is weakening."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flamme faiblit."
          }
        }
      }
    },
    "level.10-4.principle" : {
      "comment" : "What level X-4 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The flame watches from right up top, far from the chasm. Tend to it without losing the detour."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flamme veille tout en haut, loin du gouffre. Servez-la sans perdre le détour."
          }
        }
      }
    },
    "level.10-4.title" : {
      "comment" : "Title of level X-4. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the flame above"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la flamme en haut"
          }
        }
      }
    },
    "level.10-5.hint.firstSwallow" : {
      "comment" : "Instruction shown during level X-5 when something is swallowed for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One lost, not both. It goes back to the start."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une de perdue, pas les deux. Elle revient au départ."
          }
        }
      }
    },
    "level.10-5.hint.start" : {
      "comment" : "Instruction shown during level X-5 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Their paths cross at the centre, where the chasm is waiting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leurs chemins se croisent au centre, là où le gouffre attend."
          }
        }
      }
    },
    "level.10-5.principle" : {
      "comment" : "What level X-5 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two glimmers cross around the chasm. Each one keeps to its own side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux lueurs se croisent autour du gouffre. Chacune son côté."
          }
        }
      }
    },
    "level.10-5.title" : {
      "comment" : "Title of level X-5. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "on either side"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "de part et d'autre"
          }
        }
      }
    },
    "level.10-6.hint.firstSwallow" : {
      "comment" : "Instruction shown during level X-6 when something is swallowed for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swallowed. And if it was closed, the next ones open again too."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avalée. Et si elle était fermée, les suivantes s'ouvrent aussi."
          }
        }
      }
    },
    "level.10-6.hint.start" : {
      "comment" : "Instruction shown during level X-6 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The order first; then the corridors along the edges, far from the mouths."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ordre d'abord ; puis les couloirs des bords, loin des bouches."
          }
        }
      }
    },
    "level.10-6.principle" : {
      "comment" : "What level X-6 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two chasms, three glimmers, in order. The first one's iris lies between the mouths."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux gouffres, trois lueurs, dans l'ordre. L'iris de la première est entre les bouches."
          }
        }
      }
    },
    "level.10-6.title" : {
      "comment" : "Title of level X-6. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the abyss"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "l'abîme"
          }
        }
      }
    },
    "level.10-7.hint.afterSeconds.30" : {
      "comment" : "Instruction shown during level X-7 when 30 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your eyes stay on the point; it is your head that traces the circle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les yeux restent sur le point ; c'est la tête qui dessine le cercle."
          }
        }
      }
    },
    "level.10-7.hint.firstOculoSuccess" : {
      "comment" : "Instruction shown during level X-7 when the first oculomotor target is reached. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now trace the circle with your head, starting towards the right."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenant, dessinez le cercle avec la tête, en partant vers la droite."
          }
        }
      }
    },
    "level.10-7.hint.oculoCompleted" : {
      "comment" : "Instruction shown during level X-7 when the oculomotor sequence is complete. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both circles are done. The glimmer wakes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux cercles sont faits. La lueur s'éveille."
          }
        }
      }
    },
    "level.10-7.hint.oculoHelp" : {
      "comment" : "Late help for level X-7, shown when the player is still on the same oculomotor sequence after a while. Encouraging, never corrective.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A small movement is enough: the ring fills as your head follows the circle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit mouvement suffit : l'anneau se remplit quand la tête suit le cercle."
          }
        }
      }
    },
    "level.10-7.hint.oculoStageCompleted.0" : {
      "comment" : "Instruction shown during level X-7 when stage 0 of the oculomotor sequence is complete. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full circle! Come back to face forward, eyes on the point."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tour complet ! Revenez de face, les yeux sur le point."
          }
        }
      }
    },
    "level.10-7.hint.oculoSuccessInStage.1.1" : {
      "comment" : "Instruction shown during level X-7 when target 1 of oculomotor stage 1 is reached. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now the circle the other way, starting towards the left."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenant, le cercle dans l'autre sens, en partant vers la gauche."
          }
        }
      }
    },
    "level.10-7.hint.oculoSuccessInStage.1.6" : {
      "comment" : "Instruction shown during level X-7 when target 6 of oculomotor stage 1 is reached. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eyes on the point, one last time."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les yeux sur le point, une dernière fois."
          }
        }
      }
    },
    "level.10-7.hint.start" : {
      "comment" : "Instruction shown during level X-7 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your eyes on the point."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez les yeux sur le point."
          }
        }
      }
    },
    "level.10-7.principle" : {
      "comment" : "What level X-7 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at the point at the centre.\nKeep your eyes on it and turn your head slowly in a circle.\nGo all the way round, then start again the other way."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez le point au centre.\nGardez vos yeux dessus et tournez doucement la tête en rond.\nFaites le tour complet, puis recommencez dans l'autre sens."
          }
        }
      }
    },
    "level.10-7.title" : {
      "comment" : "Title of level X-7. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the anchor"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "l'ancre"
          }
        }
      }
    },
    "level.11-1.hint.afterSeconds.30" : {
      "comment" : "Instruction shown during level XI-1 when 30 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A brief look is enough. Then look elsewhere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un regard bref suffit. Puis regardez ailleurs."
          }
        }
      }
    },
    "level.11-1.hint.braiseFlared" : {
      "comment" : "Instruction shown during level XI-1 when a braise flares up. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looked at too long, it panics."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop regardée, elle s'affole."
          }
        }
      }
    },
    "level.11-1.hint.braiseLit" : {
      "comment" : "Instruction shown during level XI-1 when a braise catches. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lights up and flees. Let it come."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle s'allume et fuit. Laissez-la venir."
          }
        }
      }
    },
    "level.11-1.hint.start" : {
      "comment" : "Instruction shown during level XI-1 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is cold. Look at it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est froide. Regardez-la."
          }
        }
      }
    },
    "level.11-1.principle" : {
      "comment" : "What level XI-1 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps, cold. Your gaze wakes it, and it flees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle dort, froide. Votre regard la réveille, et elle fuit."
          }
        }
      }
    },
    "level.11-1.title" : {
      "comment" : "Title of level XI-1. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the ember"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la braise"
          }
        }
      }
    },
    "level.11-2.hint.braiseFlared" : {
      "comment" : "Instruction shown during level XI-2 when a braise flares up. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panicked, it flees from further away. Look elsewhere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affolée, elle fuit de plus loin. Regardez ailleurs."
          }
        }
      }
    },
    "level.11-2.hint.start" : {
      "comment" : "Instruction shown during level XI-2 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wake them one after the other."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réveillez-les l'une après l'autre."
          }
        }
      }
    },
    "level.11-2.principle" : {
      "comment" : "What level XI-2 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two embers, two wakings. Wake them from the side opposite their iris."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux braises, deux réveils. Réveillez-les du côté opposé à leur iris."
          }
        }
      }
    },
    "level.11-2.title" : {
      "comment" : "Title of level XI-2. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "two embers"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "deux braises"
          }
        }
      }
    },
    "level.11-3.hint.braiseLit" : {
      "comment" : "Instruction shown during level XI-3 when a braise catches. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rises. The current is going to carry it to the left."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle monte. Le courant va l'emporter vers la gauche."
          }
        }
      }
    },
    "level.11-3.hint.start" : {
      "comment" : "Instruction shown during level XI-3 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cold, it waits below the current."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Froide, elle attend sous le courant."
          }
        }
      }
    },
    "level.11-3.principle" : {
      "comment" : "What level XI-3 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once awake, it rises into the current. Push it through."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réveillée, elle monte dans le courant. Poussez-la au travers."
          }
        }
      }
    },
    "level.11-3.title" : {
      "comment" : "Title of level XI-3. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the ember and the current"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la braise et le courant"
          }
        }
      }
    },
    "level.11-4.hint.braiseLit" : {
      "comment" : "Instruction shown during level XI-4 when a braise catches. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awake, it flies towards the veil. Push it to the left."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réveillée, elle vole vers le voile. Poussez-la vers la gauche."
          }
        }
      }
    },
    "level.11-4.hint.start" : {
      "comment" : "Instruction shown during level XI-4 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The veil blocks the right side. The way through is on the left."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voile ferme la droite. Le passage est à gauche."
          }
        }
      }
    },
    "level.11-4.principle" : {
      "comment" : "What level XI-4 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its iris is behind the veil. Wake it, then go around."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son iris est derrière le voile. Réveillez-la, puis contournez."
          }
        }
      }
    },
    "level.11-4.title" : {
      "comment" : "Title of level XI-4. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the ember and the veil"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la braise et le voile"
          }
        }
      }
    },
    "level.11-5.hint.firstWake" : {
      "comment" : "Instruction shown during level XI-5 when something wakes for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The echo has woken it. It reaches its iris."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écho l'a réveillée. Elle rejoint son iris."
          }
        }
      }
    },
    "level.11-5.hint.start" : {
      "comment" : "Instruction shown during level XI-5 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two sleeps: one gives way to a look, the other to an echo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux sommeils : l'un cède au regard, l'autre à l'écho."
          }
        }
      }
    },
    "level.11-5.principle" : {
      "comment" : "What level XI-5 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ember wakes at a look; its closed iris wakes the sleeper."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La braise s'éveille au regard ; son iris fermé réveille la dormeuse."
          }
        }
      }
    },
    "level.11-5.title" : {
      "comment" : "Title of level XI-5. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "two wakings"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "deux réveils"
          }
        }
      }
    },
    "level.11-6.hint.firstLoss" : {
      "comment" : "Instruction shown during level XI-6 when the player loses something for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An iris that opens again drags the next ones with it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un iris qui se rouvre entraîne les suivants."
          }
        }
      }
    },
    "level.11-6.hint.start" : {
      "comment" : "Instruction shown during level XI-6 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first ember, then the glimmer, then the ember behind the veil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première braise, puis la lueur, puis la braise derrière le voile."
          }
        }
      }
    },
    "level.11-6.principle" : {
      "comment" : "What level XI-6 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An ember, a glimmer, an ember. In order, with the veil across the way."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une braise, une lueur, une braise. Dans l'ordre, et le voile en travers."
          }
        }
      }
    },
    "level.11-6.title" : {
      "comment" : "Title of level XI-6. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "three fires"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "trois feux"
          }
        }
      }
    },
    "level.11-7.hint.afterSeconds.45" : {
      "comment" : "Instruction shown during level XI-7 when 45 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not turn your head to search: let your eyes find it, your head follows on its own."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne tournez pas la tête pour chercher : laissez les yeux trouver, la tête suit d'elle-même."
          }
        }
      }
    },
    "level.11-7.hint.firstOculoMiss" : {
      "comment" : "Instruction shown during level XI-7 when the first oculomotor target is missed. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It went out without you. The next one lights up somewhere else."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle s'est éteinte sans vous. La suivante s'allume ailleurs."
          }
        }
      }
    },
    "level.11-7.hint.firstOculoSuccess" : {
      "comment" : "Instruction shown during level XI-7 when the first oculomotor target is reached. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It gave you its warmth. Eyes first, head after: that is when it gives the most."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle vous a donné sa chaleur. Les yeux d'abord, la tête ensuite : c'est là qu'elle en donne le plus."
          }
        }
      }
    },
    "level.11-7.hint.oculoCompleted" : {
      "comment" : "Instruction shown during level XI-7 when the oculomotor sequence is complete. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warmth enough. The ember is still asleep: a brief look will wake it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assez de chaleur. La braise dort encore : un regard bref la réveillera."
          }
        }
      }
    },
    "level.11-7.hint.start" : {
      "comment" : "Instruction shown during level XI-7 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An ember is about to light up at the edge of the screen. Let your eyes go to it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une braise va s'allumer au bord de l'écran. Laissez vos yeux y aller."
          }
        }
      }
    },
    "level.11-7.principle" : {
      "comment" : "What level XI-7 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Embers light up at the edge. Go there with your eyes first, then let your head follow: they give all their warmth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des braises s'allument au bord. Allez-y des yeux d'abord, puis laissez la tête suivre : elles donnent toute leur chaleur."
          }
        }
      }
    },
    "level.11-7.title" : {
      "comment" : "Title of level XI-7. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "eyes first"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "d'abord les yeux"
          }
        }
      }
    },
    "level.12-1.hint.firstWake" : {
      "comment" : "Instruction shown during level XII-1 when something wakes for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set off by the echo, it reaches its iris."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancée par l'écho, elle rejoint son iris."
          }
        }
      }
    },
    "level.12-1.hint.start" : {
      "comment" : "Instruction shown during level XII-1 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go around the chasm with the sleeper, until it is within reach of the upper iris."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contournez le gouffre avec la dormeuse, jusqu'à portée de l'iris du haut."
          }
        }
      }
    },
    "level.12-1.principle" : {
      "comment" : "What level XII-1 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sleeper is far from the iris that must wake it, and the chasm lies in the way."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dormeuse est loin de l'iris qui doit la réveiller, et le gouffre est sur le chemin."
          }
        }
      }
    },
    "level.12-1.title" : {
      "comment" : "Title of level XII-1. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the echo and the chasm"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "l'écho et le gouffre"
          }
        }
      }
    },
    "level.12-2.hint.braiseLit" : {
      "comment" : "Instruction shown during level XII-2 when a braise catches. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awake, it slides along the veil. Bring it onto the breath's path."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réveillée, elle glisse contre le voile. Amenez-la sur le chemin du souffle."
          }
        }
      }
    },
    "level.12-2.hint.firstCarried" : {
      "comment" : "Instruction shown during level XII-2 when something is carried for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is carried away. Stop looking at it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il l'emporte. Ne la regardez plus."
          }
        }
      }
    },
    "level.12-2.hint.start" : {
      "comment" : "Instruction shown during level XII-2 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cold, it waits below the veil. The breath rises on the left."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Froide, elle attend sous le voile. Le souffle monte à gauche."
          }
        }
      }
    },
    "level.12-2.principle" : {
      "comment" : "What level XII-2 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wake the ember, then hand it to the breath: its iris is on the other side."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réveillez la braise, puis confiez-la au souffle : son iris est de l'autre côté."
          }
        }
      }
    },
    "level.12-2.title" : {
      "comment" : "Title of level XII-2. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the ember in the mist"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la braise dans la brume"
          }
        }
      }
    },
    "level.12-3.hint.start" : {
      "comment" : "Instruction shown during level XII-3 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straight ahead is the chasm. Go round the bottom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout droit, c'est le gouffre. Passez par le bas."
          }
        }
      }
    },
    "level.12-3.hint.twinsLinked" : {
      "comment" : "Instruction shown during level XII-3 when the two twins are linked. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Within reach. Let them come together, away from the mouth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À portée. Laissez-les se rejoindre, loin de la bouche."
          }
        }
      }
    },
    "level.12-3.principle" : {
      "comment" : "What level XII-3 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chasm lies between their posts. The thread goes around it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gouffre est entre leurs postes. Le fil le contourne."
          }
        }
      }
    },
    "level.12-3.title" : {
      "comment" : "Title of level XII-3. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
