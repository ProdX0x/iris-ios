    "level.7-4.hint.start" : {
      "comment" : "Instruction shown during level VII-4 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current carries it to the left. Come in from the right."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le courant l'emporte vers la gauche. Entrez à droite."
