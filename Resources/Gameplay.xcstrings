    "level.8-2.hint.firstCarried" : {
      "comment" : "Instruction shown during level VIII-2 when something is carried for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One down. The breath will come back for the other."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une de moins. Le souffle reviendra pour l'autre."
          }
        }
      }
    },
    "level.8-2.hint.start" : {
      "comment" : "Instruction shown during level VIII-2 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They spread out towards the edges. The breath passes through the middle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles s'écartent vers les bords. Le souffle passe au milieu."
          }
        }
      }
    },
    "level.8-2.principle" : {
      "comment" : "What level VIII-2 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two glimmers, a single path. Together, or one after the other."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux lueurs, un seul chemin. Ensemble, ou l'une après l'autre."
