    "level.8-5.hint.start" : {
      "comment" : "Instruction shown during level VIII-5 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first breath sets it down between the veils. The second passes on the right."
          }
        },
