    "chapter.11.principle" : {
      "comment" : "The single line that says what chapter XI (11 of 12) teaches. Shown on the chapter card. It states a principle, never an instruction to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A brief look wakes it. A long look panics it."
