        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez un coin de l'écran, loin de la lueur."
          }
        }
      }
    },
    "level.1-1.hint.attentionLeftField" : {
      "comment" : "Instruction shown during level I-1 when the gaze leaves the useful area. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
