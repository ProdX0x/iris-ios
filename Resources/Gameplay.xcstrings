            "value" : "the hidden garden"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "le jardin caché"
          }
        }
      }
    },
    "level.7-1.hint.afterSeconds.30" : {
      "comment" : "Instruction shown during level VII-1 when 30 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look above the upper one to push it downwards."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez au-dessus de celle du haut pour la pousser vers le bas."
          }
        }
      }
    },
    "level.7-1.hint.firstHold" : {
      "comment" : "Instruction shown during level VII-1 when the player holds their gaze steady for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold it: they close on one another."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez : elles se ferment l'une sur l'autre."
          }
        }
      }
    },
    "level.7-1.hint.firstIntrusion" : {
      "comment" : "Instruction shown during level VII-1 when something enters the playfield for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push one towards the other, with your gaze."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez l'une vers l'autre, par le regard."
          }
        }
      }
    },
    "level.7-1.hint.start" : {
      "comment" : "Instruction shown during level VII-1 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They have no iris. Each one is the other's iris."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles n'ont pas d'iris. Chacune est l'iris de l'autre."
          }
        }
      }
    },
    "level.7-1.hint.twinsLinked" : {
      "comment" : "Instruction shown during level VII-1 when the two twins are linked. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They have seen each other. Let them come together."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles se sont vues. Laissez-les se rejoindre."
          }
        }
      }
    },
    "level.7-1.principle" : {
      "comment" : "What level VII-1 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two glimmers, no iris. Bring one within reach of the other."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux lueurs, aucun iris. Amenez l'une à portée de l'autre."
          }
        }
      }
    },
