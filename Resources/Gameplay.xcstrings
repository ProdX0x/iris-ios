    "level.8-3.hint.firstCarried" : {
      "comment" : "Instruction shown during level VIII-3 when something is carried for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The breath is stronger than the current."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le souffle est plus fort que le courant."
          }
        }
