    "level.6-7.hint.afterSeconds.40" : {
      "comment" : "Instruction shown during level VI-7 when 40 seconds have passed without the level being finished. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A glance costs nothing. Only the seeds that breathe are worth resting your gaze on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un coup d'œil ne coûte rien. Seules les graines qui respirent méritent qu'on s'y attarde."
          }
        }
      }
    },
    "level.6-7.hint.firstOculoMiss" : {
      "comment" : "Instruction shown during level VI-7 when the first oculomotor target is missed. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That one was only glittering: the shoots have folded away. Keep looking."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celle-ci ne faisait que scintiller : les pousses se sont repliées. Cherchez encore."
          }
        }
      }
    },
    "level.6-7.hint.firstOculoSuccess" : {
      "comment" : "Instruction shown during level VI-7 when the first oculomotor target is reached. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It grows. Another one is breathing somewhere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle pousse. Une autre respire quelque part."
          }
        }
      }
    },
    "level.6-7.hint.oculoCompleted" : {
      "comment" : "Instruction shown during level VI-7 when the oculomotor sequence is complete. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The garden is open. The iris slides: let the glimmer reach it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jardin est ouvert. L'iris glisse : laissez la lueur le rejoindre."
          }
        }
      }
    },
    "level.6-7.hint.start" : {
      "comment" : "Instruction shown during level VI-7 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They all glitter. Look for the ones breathing slowly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes scintillent. Cherchez celles qui respirent lentement."
          }
        }
      }
    },
    "level.6-7.principle" : {
      "comment" : "What level VI-7 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seeds everywhere. A few are breathing: find them with your gaze and they grow."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des graines partout. Quelques-unes respirent : trouvez-les du regard, elles poussent."
          }
        }
      }
    },
    "level.6-7.title" : {
      "comment" : "Title of level VI-7. Short, lowercase, evocative; names what the eyes do. Not an instruction, no final period.",
      "extractionState" : "manual",
      "localizations" : {
