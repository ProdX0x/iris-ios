    },
    "level.1-6.principle" : {
      "comment" : "What level I-6 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
