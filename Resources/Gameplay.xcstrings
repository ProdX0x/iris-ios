    "level.8-6.hint.start" : {
      "comment" : "Instruction shown during level VIII-6 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
