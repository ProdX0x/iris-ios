    },
    "level.1-6.hint.balisesCompleted" : {
      "comment" : "Instruction shown during level I-6 when every balise is awake. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The thread is complete: the iris opens and a glimmer wakes. Let it come."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fil est complet : l'iris s'ouvre et une lueur s'éveille. Laissez-la venir."
          }
        }
      }
    },
    "level.1-6.hint.firstBalise" : {
      "comment" : "Instruction shown during level I-6 when the first balise wakes. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It reaches out a thread. Follow it with your gaze, beacon after beacon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle tend un fil. Suivez-le du regard, balise après balise."
          }
        }
      }
    },
    "level.1-6.hint.start" : {
      "comment" : "Instruction shown during level I-6 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beacon is breathing at the centre. Rest your gaze on it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une balise respire au centre. Posez-y le regard."
          }
