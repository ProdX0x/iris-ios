    "level.7-6.hint.firstLoss" : {
      "comment" : "Instruction shown during level VII-6 when the player loses something for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
