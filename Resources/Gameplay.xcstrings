    },
    "level.8-1.hint.firstCarried" : {
      "comment" : "Instruction shown during level VIII-1 when something is carried for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is carried away. Stop looking at it."
