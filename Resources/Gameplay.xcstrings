    },
    "level.7-4.hint.twinsLinked" : {
      "comment" : "Instruction shown during level VII-4 when the two twins are linked. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
