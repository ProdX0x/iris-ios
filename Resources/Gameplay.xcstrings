    "chapter.1.principle" : {
      "comment" : "The single line that says what chapter I (1 of 12) teaches. Shown on the chapter card. It states a principle, never an instruction to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you look at moves away."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous regardez s'éloigne."
          }
        }
      }
    },
