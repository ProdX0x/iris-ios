        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il l'emporte. Ne la regardez plus."
          }
        }
      }
    },
    "level.8-1.hint.firstIntrusion" : {
      "comment" : "Instruction shown during level VIII-1 when something enters the playfield for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the breath comes near, bring it onto its path."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand le souffle approche, amenez-la sur son chemin."
          }
        }
      }
    },
    "level.8-1.hint.start" : {
      "comment" : "Instruction shown during level VIII-1 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Against the veil, it slides towards its iris. The breath passes elsewhere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contre le voile, elle glisse vers son iris. Le souffle passe ailleurs."
          }
        }
      }
    },
    "level.8-1.principle" : {
      "comment" : "What level VIII-1 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
