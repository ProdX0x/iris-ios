    "level.7-7.hint.firstOculoSuccess" : {
      "comment" : "Instruction shown during level VII-7 when the first oculomotor target is reached. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She calls her sister, on the other side. Answer her."
          }
        },
        "fr" : {
