    },
    "hint.generic.oculo" : {
      "comment" : "Late help shown in any level that names none of its own, chosen by the shape of the level (`oculo`). Generic on purpose: it must fit every level of that shape.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game shows you where to rest your gaze: follow what breathes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu vous montre où poser le regard : suivez ce qui respire."
          }
        }
      }
    },
    "hint.generic.route" : {
      "comment" : "Late help shown in any level that names none of its own, chosen by the shape of the level (`route`). Generic on purpose: it must fit every level of that shape.",
      "extractionState" : "manual",
