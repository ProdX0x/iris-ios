    "element.absence.name" : {
      "comment" : "Name of the game element `absence`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "absence"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "absence"
          }
        }
      }
    },
    "element.absence.summary" : {
      "comment" : "What the element `absence` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A presence holds as long as you look at it. When another answers, sometimes after a silence, go to it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une présence tient tant que vous la regardez. Quand une autre répond, parfois après un silence, allez à elle."
          }
        }
      }
    },
    "element.ancre.name" : {
      "comment" : "Name of the game element `ancre`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anchor"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ancre"
          }
        }
      }
    },
    "element.ancre.summary" : {
      "comment" : "What the element `ancre` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A point at the centre of a silhouette. With your eyes resting on it, your head traces a slow circle: the ring fills, then fills again the other way."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un point au centre d'une silhouette. Les yeux posés dessus, la tête dessine un cercle lent : l'anneau se remplit, puis dans l'autre sens."
          }
        }
      }
    },
    "element.balise.name" : {
      "comment" : "Name of the game element `balise`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "beacon"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "balise"
          }
        }
      }
    },
    "element.balise.summary" : {
      "comment" : "What the element `balise` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It wakes under a resting gaze, then extends a thread towards the next one. The complete thread opens the iris."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle s'éveille sous un regard posé, puis tend un fil vers la suivante. Le fil complet ouvre l'iris."
          }
        }
      }
    },
    "element.braise.name" : {
      "comment" : "Name of the game element `braise`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ember"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "braise"
          }
        }
      }
    },
    "element.braise.summary" : {
      "comment" : "What the element `braise` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cold, it sleeps. A brief look wakes it and it flees; a long look panics it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Froide, elle dort. Un regard bref la réveille et elle fuit ; un regard long l'affole."
          }
        }
      }
    },
    "element.cascade.name" : {
      "comment" : "Name of the game element `cascade`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cascade"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cascade"
          }
        }
      }
    },
    "element.cascade.summary" : {
      "comment" : "What the element `cascade` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If one glimmer loses its place, the ones behind it lose theirs too."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une lueur perd sa place, celles qui la suivent la perdent aussi."
          }
        }
      }
    },
    "element.coeur.name" : {
      "comment" : "Name of the game element `coeur`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "glass heart"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cœur de verre"
          }
        }
      }
    },
    "element.coeur.summary" : {
      "comment" : "What the element `coeur` does, in one line, in the carnet. Describes behaviour the player can verify on screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cold, it warms under a gaze that stays. The sparks around it are only waiting for your gaze to cool it down again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Froid, il se réchauffe sous un regard qui reste. Les étincelles autour n'attendent que votre regard pour le refroidir."
          }
        }
      }
    },
    "element.courant.name" : {
      "comment" : "Name of the game element `courant`, as the carnet lists it. Iris names its own things: keep the poetry, do not translate it into a generic game term.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
