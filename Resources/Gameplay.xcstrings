    },
    "level.9-1.hint.firstWake" : {
      "comment" : "Instruction shown during level IX-1 when something wakes for the first time. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awake, it lives like the others. Let it settle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réveillée, elle vit comme les autres. Laissez-la se poser."
          }
        }
      }
    },
    "level.9-1.hint.start" : {
      "comment" : "Instruction shown during level IX-1 when the level opens. Read mid-play, while the player is looking at something else: keep it short, calm, and addressed to the player.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lower glimmer is asleep. Nothing will move it but an echo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lueur du bas dort. Rien ne la fera bouger, sauf un écho."
          }
        }
      }
    },
    "level.9-1.principle" : {
      "comment" : "What level IX-1 is about, in one line, shown before the level starts. States the idea; the instructions are the hints.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The second one sleeps. Close the first iris: its echo wakes it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La seconde dort. Fermez le premier iris : son écho la réveille."
          }
        }
